{
  "name": "@sovereignkit/collector",
  "version": "0.1.0",
  "description": "Allowlisted, schema-validating, durable ProbeResult collector",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "bin": {
    "sovereignkit-collector": "./dist/collector-process.js",
    "sovereignkit-observer": "./dist/observer-process.js",
    "sovereignkit-observer-runtime": "./dist/observer-runtime-process.js",
    "sovereignkit-observer-keygen": "./dist/observer-keygen-process.js",
    "sovereignkit-assignment-keygen": "./dist/assignment-authority-keygen-process.js",
    "sovereignkit-assignment-sign": "./dist/observation-assignment-sign-process.js",
    "sovereignkit-observation-worker": "./dist/observation-worker-process.js"
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ../../node_modules/vitest/vitest.mjs run src",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage src"
  },
  "dependencies": {
    "@sovereignkit/probes": "workspace:*",
    "@sovereignkit/telemetry": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@solana/kit": "7.0.0"
  }
}
