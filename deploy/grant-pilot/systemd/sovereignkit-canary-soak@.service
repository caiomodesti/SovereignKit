[Unit]
Description=SovereignKit 24-hour observer canary soak %i
After=network-online.target sovereignkit-observer.service
Wants=network-online.target

[Service]
Type=oneshot
User=sovereignkit
Group=sovereignkit
WorkingDirectory=/opt/sovereignkit
ExecStart=/usr/bin/node scripts/run-grant-m1-canary-soak.mjs --observer-id %i --health-url http://127.0.0.1:8790/ready --duration-seconds 86400 --interval-seconds 60 --request-timeout-ms 5000 --output /var/lib/sovereignkit/evidence/canary-%i.jsonl --summary-output /var/lib/sovereignkit/evidence/canary-%i-summary.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadOnlyPaths=/opt/sovereignkit /etc/sovereignkit
ReadWritePaths=/var/lib/sovereignkit/evidence
UMask=0077
