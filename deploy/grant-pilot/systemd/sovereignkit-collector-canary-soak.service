[Unit]
Description=SovereignKit 24-hour Collector canary soak
After=network-online.target sovereignkit-collector.service
Wants=network-online.target
Requires=sovereignkit-collector.service

[Service]
Type=oneshot
User=sovereignkit
Group=sovereignkit
WorkingDirectory=/opt/sovereignkit
ExecStart=/usr/local/bin/node scripts/run-grant-m1-collector-canary-soak.mjs --component-id collector-oracle-e4-gru-canary --health-url http://127.0.0.1:8787/health --duration-seconds 86400 --interval-seconds 60 --request-timeout-ms 5000 --output /var/lib/sovereignkit/evidence/collector-canary.jsonl --summary-output /var/lib/sovereignkit/evidence/collector-canary-summary.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadOnlyPaths=/opt/sovereignkit /etc/sovereignkit
ReadWritePaths=/var/lib/sovereignkit
UMask=0077

[Install]
WantedBy=multi-user.target
