{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereignkit.org/spec/grant-m1-experiment-plan.schema.json",
  "title": "Signed Grant M1 Experiment Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "issuer_id", "issuer_key_id", "issued_at", "experiment_definition_hash", "observers", "payload_hash", "issuer_signature"],
  "properties": {
    "schema_version": { "const": "GrantM1ExperimentPlan@0.1.0" },
    "plan_id": { "type": "string", "format": "uuid" },
    "issuer_id": { "$ref": "#/$defs/identifier" },
    "issuer_key_id": { "$ref": "#/$defs/identifier" },
    "issued_at": { "type": "string", "format": "date-time" },
    "experiment_definition_hash": { "$ref": "#/$defs/sha256" },
    "observers": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/observerPlan" } },
    "payload_hash": { "$ref": "#/$defs/sha256" },
    "issuer_signature": { "type": "string", "minLength": 80, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observerPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["observer_id", "expected_unit_ids"],
      "properties": {
        "observer_id": { "$ref": "#/$defs/identifier" },
        "expected_unit_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } }
      }
    }
  }
}
